# Optional browser basemap. Restrict this public key to your origins and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Your Valhalla instance needs an OSM extract and /route and /trace_attributes enabled.
VALHALLA_URL=https://valhalla1.openstreetmap.de
# A Valhalla-compatible /height service. Omit to use Valhalla's configured DEM.
ELEVATION_URL=
# Describe the actual data installed in your elevation service; these are examples, not assertions.
ELEVATION_DATASET=
ELEVATION_DATUM=
ELEVATION_RESOLUTION_M=
OSM_DATA_VERSION=
# Use a saved Overpass JSON extract for repeated studies; paths are relative to the project root.
OSM_GRAPH_FILE=
# Optional Overpass-compatible service for small interactive graph queries. No public server is assumed.
OVERPASS_URL=
# Enable only with documented data and services that permit batch requests.
ALLOW_BATCH_STUDIES=false
